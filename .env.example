# Required for `docker compose up`. Pick a strong value; this is the password
# both the Postgres superuser and the app's DATABASE_URL will use.  docker-compose
# refuses to start if this is unset.
POSTGRES_PASSWORD=

# Used when running the app directly (pnpm dev) instead of via docker compose.
# The docker stack derives its own DATABASE_URL from POSTGRES_PASSWORD above.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/invoice

PORT=3000
# Bind interface for the published Docker port. Keep 127.0.0.1 unless you
# have a reverse proxy in front (the app has no auth, see README).
BIND_HOST=127.0.0.1

UPLOADS_DIR=/app/uploads
PDF_RENDER_CONCURRENCY=4
