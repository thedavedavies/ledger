# Required for `docker compose up`. Pick a strong value and use only
# URL-safe characters (letters, digits, hyphen, underscore) so it can be
# embedded in DATABASE_URL without escaping. The reserved set @ : / ? # &
# will break the connection string at parse time, not at runtime.
#
# Suggested: openssl rand -hex 32
POSTGRES_PASSWORD=

# Used when running the app directly (pnpm dev) instead of via docker compose.
# The docker stack derives its own DATABASE_URL from POSTGRES_PASSWORD above.
# If your local Postgres password contains URL-reserved characters, percent-
# encode them here (`@` -> `%40`, `:` -> `%3A`, etc.).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/invoice

PORT=3000
# Bind interface for the published Docker port. Keep 127.0.0.1 unless you
# have a reverse proxy in front (the app has no auth, see README).
BIND_HOST=127.0.0.1

UPLOADS_DIR=/app/uploads
PDF_RENDER_CONCURRENCY=4
